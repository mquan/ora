{
  "name": "gregorian",
  "version": "0.0.0",
  "description": "A calendar your agents read AND write — schedule and record local AI agent runs (Claude Code, Codex).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gregorian": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "prestart": "npm run build",
    "start": "node dist/cli/index.js daemon",
    "cli": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
